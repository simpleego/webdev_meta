## 📘 BookManager.svelte (도서 관리)

```svelte
<script>
  import { onMount } from 'svelte';
  import axios from 'axios';

  let books = [];
  let newBook = { bookname: '', publisher: '', price: 0 };

  onMount(async () => {
    const res = await axios.get('/api/books');
    books = res.data;
  });

  async function addBook() {
    await axios.post('/api/books', newBook);
    alert('도서 등록 완료!');
  }

  async function deleteBook(id) {
    await axios.delete(`/api/books/${id}`);
    books = books.filter(b => b.id !== id);
  }
</script>

<h3>📘 도서 관리</h3>
<input bind:value={newBook.bookname} placeholder="제목" />
<input bind:value={newBook.publisher} placeholder="출판사" />
<input type="number" bind:value={newBook.price} placeholder="가격" />
<button on:click={addBook}>등록</button>

<table>
  <thead><tr><th>제목</th><th>출판사</th><th>가격</th><th>삭제</th></tr></thead>
  <tbody>
    {#each books as book}
      <tr>
        <td>{book.bookname}</td>
        <td>{book.publisher}</td>
        <td>{book.price}</td>
        <td><button on:click={() => deleteBook(book.id)}>삭제</button></td>
      </tr>
    {/each}
  </tbody>
</table>
```

