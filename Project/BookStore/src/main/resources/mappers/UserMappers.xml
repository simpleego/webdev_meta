<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.bookstore.users.mapper.UserMapper">

    <select id="findById" resultType="User">
        SELECT * FROM users WHERE custid = #{custId}
    </select>

    <insert id="save" parameterType="User">
        INSERT INTO users (name, username, password, birthday, email, address, phone)
        VALUES(#{name}, #{userName}, #{password}, #{birthday}, #{email}, #{address}, #{phone})
    </insert>

    <update id="updateUser" parameterType="User">
        UPDATE users
        SET address = #{address},
            email = #{email},
            phone = #{phone}
        WHERE custid = #{custId}
    </update>

    <select id="existsByUsername" parameterType="String" resultType="int">
        SELECT COUNT(*) FROM users WHERE username = #{username}
    </select>
